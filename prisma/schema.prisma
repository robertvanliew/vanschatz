generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Guest {
  id          String        @id @default(cuid())
  token       String        @unique
  name        String
  email       String?
  phone       String?
  party       String?       // who they're invited to bring (names)
  rsvpStatus  String        @default("PENDING") // PENDING | YES | NO
  partySize   Int           @default(0) // total headcount = adults + children
  adults      Int           @default(0)
  children    Int           @default(0)
  respondedAt DateTime?
  /// Null for guests the couple added. "website" marks someone who RSVP'd from
  /// the printed invite's QR without a personal link and wasn't already on the
  /// list — worth seeing, since it may be a duplicate of an existing guest
  /// under a different spelling.
  source      String?
  createdAt   DateTime      @default(now())
  reminders   ReminderLog[]
  giftClaims  GiftClaim[]
  contributions Contribution[]
}

/// A single registry item. Guests are sent to `url` to buy it; nothing is sold
/// here. `priceCents` is approximate and may be absent — retailers move prices
/// constantly and several block us from reading them at all.
model Gift {
  id         String     @id @default(cuid())
  slug       String     @unique
  title      String
  note       String? // "14-in-1, 8.5 qt, sea salt grey"
  retailer   String // "Amazon", "West Elm", ...
  url        String
  /// "/registry/<slug>.jpg" for seeded gifts, or an absolute URL for gifts added
  /// later — Vercel's filesystem is read-only at runtime, so the admin form
  /// takes an image link rather than an upload.
  image      String?
  priceCents Int?
  sortOrder  Int        @default(0)
  active     Boolean    @default(true)
  createdAt  DateTime   @default(now())
  claim      GiftClaim?
}

/// One row per claimed gift. The unique constraint on giftId is what actually
/// prevents two guests buying the same present — not the hidden button.
model GiftClaim {
  id          String   @id @default(cuid())
  giftId      String   @unique
  gift        Gift     @relation(fields: [giftId], references: [id], onDelete: Cascade)
  guestId     String?
  guest       Guest?   @relation(fields: [guestId], references: [id], onDelete: SetNull)
  claimedName String? // for a claim made without an invite link
  /// How the gift is reaching Julie & Robert: null (not yet said), "SHIP" or
  /// "BRING". Lets them know what to expect by post and what arrives on the day.
  delivery    String?
  claimedAt   DateTime @default(now())
}

/// Small key/value store for things the couple edits themselves and that must
/// not live in the repository — currently their shipping address. Deliberately
/// not typed columns: these are a handful of free-text settings, and a table per
/// setting would be worse.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model ReminderLog {
  id          String   @id @default(cuid())
  guestId     String
  guest       Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  scheduleKey String   // "1month" | "1week" | "3days" | "manual-<iso>"
  channel     String   // "email" | "sms"
  simulated   Boolean  @default(true)
  sentAt      DateTime @default(now())

  @@unique([guestId, scheduleKey, channel])
}

/// A named piece of the honeymoon guests can put money toward — "dinner for
/// two", "a night's stay". Cash is a hard thing to ask for; a specific thing
/// with a price is an easy yes, and it gives the couple something particular to
/// say thank you for.
model FundTile {
  id            String         @id @default(cuid())
  slug          String         @unique
  title         String
  note          String?
  targetCents   Int
  /// Buttons offered on the card, e.g. [2500, 5000, 10000]. Always plus "other".
  suggested     Int[]
  sortOrder     Int            @default(0)
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  contributions Contribution[]
}

/// One guest saying they have sent money toward a tile.
///
/// This records intent, not a verified payment: money moves through PayPal,
/// which tells us nothing. `confirmed` is the couple ticking it off against
/// their own PayPal history. The public bar counts every row, because a bar
/// that only moves after manual confirmation kills the momentum that makes
/// this work at all.
model Contribution {
  id          String   @id @default(cuid())
  tileId      String
  tile        FundTile @relation(fields: [tileId], references: [id], onDelete: Cascade)
  guestId     String?
  guest       Guest?   @relation(fields: [guestId], references: [id], onDelete: SetNull)
  /// Typed name, for someone giving without a personal invite link.
  givenName   String?
  amountCents Int
  message     String?
  confirmed   Boolean  @default(false)
  createdAt   DateTime @default(now())
}
